# Настройки для подключения к почтовому серверу
# Скопируйте этот файл в .env и заполните своими данными

# IMAP настройки (для чтения писем)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# SMTP настройки (для отправки писем)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Ваш email адрес и пароль
# Для Gmail используйте App Password (не обычный пароль!)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Адрес для пересылки писем
FORWARD_TO=forward_to@example.com

# Использовать TLS (true для порта 587, false для порта 465)
USE_TLS=true

# Автозапуск email forwarder при старте Django (true/false)
AUTO_START_EMAIL_FORWARDER=true

# Порт Django dev-сервера (manage.py runserver)
DJANGO_PORT=8888

# Подключение для команды sync_russian_course --settings=config.course_sync_settings
# Обычный локальный сервер продолжает использовать SQLite.
# DB_ENGINE=postgres
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONNECT_TIMEOUT=10
# DB_SSLMODE=require

# ============================================
# Django / продакшен
# ============================================

# DEBUG=true|false
DEBUG=False

# Секретный ключ Django (сгенерируйте уникальный для продакшена)
DJANGO_SECRET_KEY=change-me-in-production

# Разрешённые Host-заголовки (через запятую, без пробелов; * — любой хост)
ALLOWED_HOSTS=russ.emiit.ru,127.0.0.1,localhost

# Для форм Django с других доменов (через запятую; для API не нужно)
CSRF_TRUSTED_ORIGINS=https://russ.emiit.ru

# CORS для /api/* — true разрешает запросы с любого сайта (браузер)
CORS_ALLOW_ALL_ORIGINS=true

# ============================================
# LLM (Pydantic AI, ProxyAPI — https://proxyapi.ru/docs/overview)
LLM_BASE_URL=https://api.proxyapi.ru/v1
LLM_API_KEY=your_proxyapi_key_here
LLM_MODEL=gpt-4o-mini

# ============================================
# Nexara ASR (speaking lessons) — https://docs.nexara.ru/
# ============================================
NEXARA_BASE_URL=https://api.nexara.ru/v1
NEXARA_API_KEY=your_nexara_api_key_here
NEXARA_MODEL=whisper-1

# ============================================
# Настройки логирования
# ============================================

# Запись в файл и/или консоль (true/false)
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Путь к файлу лога (относительно корня проекта)
LOG_FILE=logs/django.log

# Уровни логирования: DEBUG, INFO, WARNING, ERROR
DJANGO_LOG_LEVEL=INFO
API_LOG_LEVEL=INFO
FORWARDER_LOG_LEVEL=INFO
COURSES_LOG_LEVEL=INFO

# ============================================
# Примеры конфигурации для других сервисов:
# ============================================

# Yandex Mail:
# IMAP_SERVER=imap.yandex.ru
# IMAP_PORT=993
# SMTP_SERVER=smtp.yandex.ru
# SMTP_PORT=465
# USE_TLS=false

# Mail.ru:
# IMAP_SERVER=imap.mail.ru
# IMAP_PORT=993
# SMTP_SERVER=smtp.mail.ru
# SMTP_PORT=465
# USE_TLS=false

# Outlook/Hotmail:
# IMAP_SERVER=outlook.office365.com
# IMAP_PORT=993
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
# USE_TLS=true

# Yandex SpeechKit: sample generation, never exposed to lesson JavaScript
YANDEX_SPEECHKIT_API_KEY=
YANDEX_SPEECHKIT_VOICE=marina
YANDEX_SPEECHKIT_ROLE=friendly
YANDEX_SPEECHKIT_SPEED=0.7
## Управление группами и студентами основного портала (только сервер Django)
PORTAL_ROSTER_URL=https://api.emiit.ru/_wt
# Локальный WebSoft: PORTAL_ROSTER_URL=http://127.0.0.1/_wt
# Base64 от login:password выделенной учётной записи; не Bearer и не публичный JS.
PORTAL_ROSTER_TOKEN=
PORTAL_ROSTER_TIMEOUT=10
